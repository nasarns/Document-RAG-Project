# ==============================================
# Document RAG Project Configuration
# ==============================================

# LLM Provider Configuration
# Supported providers: "groq", "openai", "gemini", "ollama"
LLM_PROVIDER=groq

# API Keys
# For Groq: Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here

# For Google Gemini (OpenAI compatible endpoint or API):
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name
# Recommended models:
# Groq: "llama-3.3-70b-versatile" or "llama3-8b-8192"
# OpenAI: "gpt-4o-mini"
# Ollama: "llama3.2" or "mistral"
LLM_MODEL=llama-3.3-70b-versatile

# For Ollama / Custom Base URL (if using local LLM):
# LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=

# Vector Database Configuration (Qdrant)
# By default, local embedded storage is used in ./data/qdrant_storage
QDRANT_STORAGE_PATH=./data/qdrant_storage
QDRANT_COLLECTION_NAME=document_rag

# Embeddings Model (FastEmbed / SentenceTransformers)
# Default: "BAAI/bge-small-en-v1.5" or "sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# RAG Hyperparameters
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.35

# Application Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
